<Application x:Class="PiBotPal.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#20313A"/>
            <Setter Property="Foreground" Value="#E4EEF0"/>
            <Setter Property="BorderBrush" Value="#49616B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#132027"/>
            <Setter Property="Foreground" Value="#E4EEF0"/>
            <Setter Property="BorderBrush" Value="#49616B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
