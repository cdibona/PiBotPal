<Window x:Class="PiBotPal.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PiBotPal — Crawler control" Width="1050" Height="860" MinWidth="720" MinHeight="650" Background="#0C1217" Foreground="#DFE8ED" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="PiBotPal" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="CRAWLER CONTROL · MCP" Foreground="#77B8AB" FontSize="11"/></StackPanel>
            <Button x:Name="StopButton" Grid.Column="1" Content="■ STOP" Width="145" FontSize="18" Background="#783339" BorderBrush="#BA6670" Click="Stop_Click" ToolTip="Cancel movement and disarm; servo power stays on"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ConnectionText" Text="Disconnected · connect through Tailscale" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" AutomationProperties.Name="Robot base URL"/>
                    <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Click="Connect_Click"/>
                </Grid>
                <UniformGrid Columns="3" Margin="0,18">
                    <StackPanel><TextBlock Text="BATTERY / POWER" Foreground="#8CA4AE"/><TextBlock x:Name="PowerText" Text="— V" FontSize="29" Foreground="#6DDFC2"/><TextBlock Text="Powered while connected · charging/runtime unknown" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel><TextBlock Text="MOTION" Foreground="#8CA4AE"/><TextBlock x:Name="MotionText" Text="Disarmed" FontSize="24" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel><TextBlock Text="FRONT RANGE" Foreground="#8CA4AE"/><TextBlock x:Name="RangeText" Text="— cm" FontSize="29"/></StackPanel>
                </UniformGrid>
                <TabControl Background="#0C1217" BorderBrush="#49616B"><TabItem Header="Controller"><StackPanel TextElement.Foreground="#DFE8ED">
                <Border Background="#05090B" Height="360" CornerRadius="8"><Image x:Name="VideoImage" Stretch="Uniform" AutomationProperties.Name="Live robot camera"/></Border>
                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="VideoText" Text="Camera disconnected" VerticalAlignment="Center"/>
                    <Button x:Name="CameraButton" Grid.Column="1" Content="Enable camera" Click="Camera_Click"/>
                </Grid>
                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="ArmButton" Content="Arm motion" Click="Arm_Click"/>
                    <StackPanel Grid.Column="1" Margin="16,0"><TextBlock x:Name="SpeedText" Text="Movement speed: 35% · one gait cycle per press"/><Slider x:Name="SpeedSlider" Minimum="10" Maximum="60" Value="35" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,0" ValueChanged="Speed_Changed"/></StackPanel>
                </Grid>
                <UniformGrid Columns="3">
                    <Button x:Name="LeftButton" Content="↶ Turn left" Tag="turn left" Click="Move_Click"/>
                    <Button x:Name="ForwardButton" Content="↑ Forward" Tag="forward" Click="Move_Click"/>
                    <Button x:Name="RightButton" Content="Turn right ↷" Tag="turn right" Click="Move_Click"/>
                    <Button x:Name="StandButton" Content="Stand" Tag="stand" Click="Move_Click"/>
                    <Button x:Name="BackwardButton" Content="↓ Backward" Tag="backward" Click="Move_Click"/>
                    <Button x:Name="SitButton" Content="Sit" Tag="sit" Click="Move_Click"/>
                </UniformGrid>
                <TextBlock Text="Shared actions" FontSize="20" Margin="4,16,4,4"/>
                <TextBlock x:Name="ActionLibraryText" Text="Connect to load the robot’s action library." TextWrapping="Wrap" Margin="4,4" Foreground="#92AAB4"/>
                <ComboBox x:Name="ActionList" Margin="4" MinHeight="32" SelectionChanged="SharedAction_Changed" AutomationProperties.Name="Shared robot action"/>
                <WrapPanel><Button x:Name="RunActionButton" Content="Run selected action" Click="RunAction_Click"/><Button x:Name="RefreshActionsButton" Content="Refresh action library" Click="RefreshPlans_Click"/></WrapPanel>
                <TextBlock Margin="0,16,0,0" Text="Microphone capture is never enabled by this app. Moving away from this window stops motion. STOP holds the last servo command; it does not remove power." Foreground="#92AAB4" TextWrapping="Wrap"/>
                </StackPanel></TabItem>
                <TabItem Header="Plan"><StackPanel Margin="12" TextElement.Foreground="#DFE8ED">
                    <TextBlock Text="Saved poses &amp; motion plans" FontSize="22" Margin="0,0,0,10"/>
                    <TextBlock Text="Capture commanded servo angles, draft a sequence, review the steps, then save. Arm motion explicitly before running. The robot does not auto-arm." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="PlanStatusText" Text="No plan running" Foreground="#6DDFC2" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="RefreshPlansButton" Content="Refresh saved plans, poses and actions" Click="RefreshPlans_Click"/>
                    <TextBlock Text="Actions use the robot’s shared keyframes, including custom actions saved in the web planner. Refresh after editing them elsewhere." TextWrapping="Wrap" Foreground="#92AAB4" Margin="4,8"/>
                    <Button x:Name="OpenKeyframesButton" Content="Edit keyframes in web planner" Click="OpenKeyframes_Click"/>
                    <TextBlock Text="Saved servo pose" Margin="0,12,0,4"/>
                    <TextBox x:Name="PoseNameBox" Text="My pose" AutomationProperties.Name="Pose name"/>
                    <Button x:Name="CapturePoseButton" Content="Save current servo positions" Click="CapturePose_Click"/>
                    <ComboBox x:Name="PoseList" Margin="4" MinHeight="32" AutomationProperties.Name="Saved poses"/>
                    <WrapPanel><Button x:Name="InsertPoseButton" Content="Append pose to plan" Click="InsertPose_Click"/><Button x:Name="DeletePoseButton" Content="Delete pose" Click="DeletePose_Click"/></WrapPanel>
                    <TextBlock Text="Describe a plan" Margin="0,16,0,4"/>
                    <TextBox x:Name="PlanPromptBox" Text="Stand. Move forward 4 steps, turn left, move forward four steps." AcceptsReturn="True" Height="65" TextWrapping="Wrap" AutomationProperties.Name="Plan instructions"/>
                    <CheckBox x:Name="UsePlanLlmCheckBox" Content="Use configured LLM to draft" Foreground="#DFE8ED" Margin="4,8"/>
                    <Button x:Name="DraftPlanButton" Content="Draft steps for review" Click="DraftPlan_Click"/>
                    <TextBlock Text="Plan name" Margin="0,12,0,4"/>
                    <TextBox x:Name="PlanNameBox" Text="My plan" AutomationProperties.Name="Plan name"/>
                    <TextBlock Text="Append an action from the robot" Margin="0,12,0,4"/>
                    <ComboBox x:Name="PlanActionList" Margin="4" MinHeight="32" SelectionChanged="SharedAction_Changed" AutomationProperties.Name="Action to append to plan"/>
                    <Button x:Name="InsertActionButton" Content="Append selected action" Click="InsertAction_Click"/>
                    <TextBlock Text="Editable steps (JSON): action, saved pose, or wait" Margin="0,10,0,4"/>
                    <TextBox x:Name="PlanStepsBox" Text="[]" AcceptsReturn="True" Height="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Editable plan steps"/>
                    <WrapPanel><Button x:Name="SavePlanButton" Content="Save plan" Click="SavePlan_Click"/><Button x:Name="NewPlanButton" Content="New plan" Click="NewPlan_Click"/></WrapPanel>
                    <TextBlock Text="Saved plans" Margin="0,12,0,4"/>
                    <ComboBox x:Name="PlanList" Margin="4" MinHeight="32" SelectionChanged="PlanList_Changed" AutomationProperties.Name="Saved plans"/>
                    <WrapPanel><Button x:Name="RunPlanButton" Content="Run selected plan" Click="RunPlan_Click"/><Button x:Name="StopPlanButton" Content="Stop plan &amp; disarm" Click="Stop_Click"/><Button x:Name="DeletePlanButton" Content="Delete plan" Click="DeletePlan_Click"/></WrapPanel>
                </StackPanel></TabItem></TabControl>
                <TextBlock x:Name="ErrorText" Foreground="#F39B9B" TextWrapping="Wrap" Margin="0,12,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
