[Unit]
Description=PiBotPal robot dashboard and MCP hardware server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/PiBotPal
ExecStart=%h/PiBotPal/.venv/bin/python -m pibotpal
ExecStartPost=%h/PiBotPal/.venv/bin/python %h/PiBotPal/scripts/wait-ready.py
TimeoutStartSec=45
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/pibotpal/environment
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
